# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Safe to expose to the browser: URL and anon key are public by design, RLS
# is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or commit it. Used only for
# privileged operations such as an admin assigning a member's product access.
SUPABASE_SERVICE_ROLE_KEY=
