# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Safe to expose to the browser: URL and publishable key are public by
# design, RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this to the browser or commit it. Used only for
# privileged operations such as an admin assigning a member's product access.
# This is the "service_role" key on older Supabase projects, or the "secret
# key" on projects using the newer publishable/secret key pair.
SUPABASE_SERVICE_ROLE_KEY=
